# ====================================================================
# PACHINKO CONFIGURATION (Optimized for Windows + RX 9070 16GB)
# ====================================================================

# --- 1. Discord Bot ---
DISCORD_TOKEN=
# Enter your Discord Server ID so all 17 Slash Commands register instantly
GUILD_ID=
# Optional: Your Discord User ID(s) (comma-separated) for full Action Gate privileges
OWNER_IDS=

# --- 2. Character Brain / LLM (Default: 9router, with local Ollama automatic fallback) ---
# Options: ninerouter | ollama | openai_compat
LLM_PROVIDER=ninerouter
# Automatic fallback when primary fails: ollama (default) | none
LLM_FALLBACK=ollama

# 9router local gateway (run 9router with --host 127.0.0.1)
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
# Put the dashboard API key here
NINEROUTER_API_KEY=
# Model IDs come from GET /v1/models (e.g. what the 9router dashboard shows)
NINEROUTER_MODEL=

# Local Ollama (used when LLM_PROVIDER=ollama or as automatic fallback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Best recommendations for 16 GB VRAM RX 9070: qwen3:8b or gemma3:12b
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=15m
# Empty = use the model's own setting (Ollama Modelfile). Lower = calmer and more on-topic, higher = more creative. Typical: 0.6-0.8
LLM_TEMPERATURE=
# Compact Indonesian prompt for small local models (8B). Set false to use the legacy English prompt.
LLM_COMPACT_PROMPT=true

# Web Search: ddgs (default, free) | ninerouter (uses NINEROUTER_BASE_URL + NINEROUTER_API_KEY)
# To use Google results via 9router: connect Serper or Google PSE in the 9router dashboard, then set WEB_SEARCH_PROVIDER=ninerouter.
# Note: search queries leave this PC.
WEB_SEARCH_PROVIDER=ddgs
# Provider ID for 9router /v1/search (e.g. serper, google-pse, searchapi, tavily, brave, ollama-search); empty = 9router default
WEB_SEARCH_NINEROUTER_PROVIDER=

# --- 3. Hearing / STT (Default: Local Faster-Whisper) ---
# Options: local_whisper | groq
STT_PROVIDER=local_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=id
GROQ_API_KEY=

# --- 4. Character Voice / TTS ---
# Options:
#   edge       -> Expressive Indonesian Neural Voice (100% free, no quota, 0 VRAM, auto-falls back to piper when offline)
#   piper      -> 100% Local Offline ONNX (auto-downloaded during setup)
#   elevenlabs -> Optional ElevenLabs API (set TTS_PROVIDER=elevenlabs below)
TTS_PROVIDER=edge
# Fallback order after TTS_PROVIDER fails (piper is always kept as last resort)
TTS_FALLBACK=edge,piper
EDGE_TTS_VOICE=id-ID-GadisNeural
EDGE_TTS_RATE=+6%
EDGE_TTS_PITCH=+8Hz

# Optional ElevenLabs TTS (used when TTS_PROVIDER=elevenlabs)
# API key only needs the Text to Speech permission
ELEVENLABS_API_KEY=
# Free plan: only default/premade or your own voices work over the API; library voices need a paid plan
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional Local RVC Voice Cloning (Applio / RVC HTTP API)
RVC_ENABLED=false
RVC_API_URL=http://127.0.0.1:7897
RVC_MODEL_PATH=
RVC_PITCH_SHIFT=0

# --- 5. Voice Responsiveness & Smart Turn-Taking ---
VAD_RMS_THRESHOLD=420
TURN_FAST_SILENCE_MS=550
TURN_MAX_SILENCE_MS=1350
MIN_SPEECH_MS=320
FILLER_ENABLED=true
FILLER_DELAY_MS=1300
ALLOW_BARGE_IN=true
LOG_VOICE_TO_TEXT=true

# --- 6. Autonomy & Web Panel ---
# Default text channel mode: off | mention-only | quiet | normal | lively
DEFAULT_CHANNEL_MODE=quiet
AUTONOMY_ENABLED=true
PANEL_HOST=127.0.0.1
PANEL_PORT=7878
# Optional secret token protecting the panel API and /ws/live; open http://127.0.0.1:7878/?token=<PANEL_TOKEN>
PANEL_TOKEN=

# --- 7. RX 9070 VRAM Management (16 GB) ---
GPU_VRAM_GB=16
VRAM_OFFLOAD_FOR_SINGING=true
