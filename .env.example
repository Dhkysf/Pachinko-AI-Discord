# ====================================================================
# MIYORIA-PY CONFIGURATION (Dioptimalkan untuk Windows + RX 9070 16GB)
# ====================================================================

# --- 1. Discord Bot ---
DISCORD_TOKEN=
# Isi ID Server Discord supaya 15 Slash Command langsung muncul instan
GUILD_ID=
# Opsional: User ID Discord kamu (pisahkan koma jika lebih dari satu) untuk hak penuh Gate
OWNER_IDS=

# --- 2. Otak Karakter / LLM (Default: 100% Lokal via Ollama di RX 9070 16GB) ---
# Pilihan: ollama | openai_compat | gemini
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Rekomendasi terbaik untuk VRAM 16 GB RX 9070: qwen3:8b atau gemma3:12b
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=15m

# Opsional fallback Cloud Gemini (jika ingin dipakai saat Ollama mati)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- 3. Pendengaran / STT (Default: Lokal Faster-Whisper) ---
# Pilihan: local_whisper | groq
STT_PROVIDER=local_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=id
GROQ_API_KEY=

# --- 4. Suara Karakter / TTS ---
# Pilihan:
#   edge   -> Suara Neural Bahasa Indonesia ekspresif (100% gratis tanpa kuota, 0 VRAM, otomatis fallback ke piper jika offline)
#   piper  -> 100% Lokal Offline ONNX (otomatis diunduh saat setup)
#   elevenlabs -> Opsional API ElevenLabs
TTS_PROVIDER=edge
EDGE_TTS_VOICE=id-ID-GadisNeural
EDGE_TTS_RATE=+6%
EDGE_TTS_PITCH=+8Hz

# Opsional Voice Cloning RVC Lokal (Applio / RVC HTTP API)
RVC_ENABLED=false
RVC_API_URL=http://127.0.0.1:7897
RVC_MODEL_PATH=
RVC_PITCH_SHIFT=0

# --- 5. Responsivitas Voice & Smart Turn-Taking ---
VAD_RMS_THRESHOLD=420
TURN_FAST_SILENCE_MS=550
TURN_MAX_SILENCE_MS=1350
MIN_SPEECH_MS=320
FILLER_ENABLED=true
FILLER_DELAY_MS=1300
ALLOW_BARGE_IN=true
LOG_VOICE_TO_TEXT=true

# --- 6. Otonomi & Web Panel ---
# Mode default text channel: off | mention-only | quiet | normal | lively
DEFAULT_CHANNEL_MODE=quiet
AUTONOMY_ENABLED=true
PANEL_HOST=127.0.0.1
PANEL_PORT=7878
PANEL_TOKEN=

# --- 7. Manajemen VRAM RX 9070 (16 GB) ---
GPU_VRAM_GB=16
VRAM_OFFLOAD_FOR_SINGING=true
